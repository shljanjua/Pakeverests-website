# Local configuration (contains DB credentials) — never commit
app/config.local.php

# Uploaded media (managed from the admin panel on the live server)
uploads/*
!uploads/.gitkeep
!uploads/index.html
!uploads/.htaccess

# Runtime
app/cache/*
!app/cache/.gitkeep
*.log

# OS / editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Runtime-generated minified stylesheets
assets/css/*.min.css
